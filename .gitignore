# Copyrighted game data - never commit
game/
*.xex
*.pe
*.iso

# Runtime user data: saves, shader cache (see TenchuzApp::OnConfigurePaths)
user/

# Regenerated by `rexglue codegen`. rexglue.cmake (written by `rexglue migrate`)
# is kept: CMakeLists.txt needs it to configure a fresh clone.
generated/*
!generated/rexglue.cmake

# Build output
out/
build/

# Local tooling / downloads (build.bat and tools/macos/build.sh download the
# ReXGlue SDK). Committed: the Steamworks headers and the Windows and macOS
# Steam API libraries, which System Link over Steam builds with. Keep the
# repository private: the Steamworks SDK agreement allows shipping the
# libraries with the game, not publishing the SDK.
third_party/*
!third_party/steamworks/
third_party/steamworks/*
!third_party/steamworks/sdk/
third_party/steamworks/sdk/*
!third_party/steamworks/sdk/Readme.txt
!third_party/steamworks/sdk/public/
!third_party/steamworks/sdk/redistributable_bin/
third_party/steamworks/sdk/redistributable_bin/*
!third_party/steamworks/sdk/redistributable_bin/win64/
!third_party/steamworks/sdk/redistributable_bin/osx/
logs/
*.log

# Python bytecode
__pycache__/

# Release packages (tools/package_release.ps1)
dist/
third_party/steamworks/sdk/public/steam/lib/
