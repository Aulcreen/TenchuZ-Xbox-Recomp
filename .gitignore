# Copyrighted game data - never commit
game/
*.xex
*.pe
*.iso

# Runtime user data: saves, shader cache (see TenchuzApp::OnConfigurePaths)
user/

# Regenerated by `rexglue codegen`. rexglue.cmake (written by `rexglue migrate`)
# is kept: CMakeLists.txt needs it to configure a fresh clone.
generated/*
!generated/rexglue.cmake

# Build output
out/
build/

# Local tooling / downloads
third_party/
logs/
*.log

# Python bytecode
__pycache__/

# Release packages (tools/package_release.ps1)
dist/
